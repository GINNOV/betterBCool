        }
      }
    },
    "Available modes and features depend on your AC model. betterBCool disables options that your unit does not report as supported. Eco, Sleep and swing can be controlled from the dashboard when the unit accepts them." : {
      "comment" : "A footer for the \"Understand your AC\" page.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modalità e le funzioni disponibili dipendono dal modello del climatizzatore. betterBCool disabilita le opzioni che l’unità non dichiara di supportare. Eco, Sonno e oscillazione si possono controllare dalla schermata principale quando l’unità le supporta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available modes and features depend on your AC model. betterBCool disables options that your unit does not report as supported. Eco, Sleep and swing can be controlled from the dashboard when the unit accepts them."
          }
        }
      }
    },
