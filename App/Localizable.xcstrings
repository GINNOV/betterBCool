        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil reste éteint pendant cette durée, puis l’étape suivante commence. Pour qu’il reste éteint, faites-en la dernière étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’unità resta spenta per questa durata, poi inizia il passaggio successivo. Per mantenerla spenta, rendi questo il passaggio finale."
          }
        }
      }
    },
