    "Cool with the fan for 2 hours, stay quiet until 4:00 AM, pause for 30 minutes, then resume silently. Every detail can be changed before saving." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 Stunden mit Lüfter kühlen, bis 4:00 Uhr leise bleiben, 30 Minuten pausieren und dann leise fortsetzen. Alle Details können vor dem Speichern geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfría con el ventilador durante 2 horas, mantén el modo silencioso hasta las 4:00, pausa 30 minutos y reanuda en silencio. Puedes cambiar todos los detalles antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rafraîchissez avec le ventilateur pendant 2 heures, restez silencieux jusqu’à 4 h, faites une pause de 30 minutes, puis reprenez silencieusement. Chaque détail peut être modifié avant l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raffredda con la ventola per 2 ore, resta silenzioso fino alle 4:00, sospendi per 30 minuti, poi riprendi in modalità silenziosa. Puoi modificare ogni dettaglio prima di salvare."
          }
        }
      }
    },
